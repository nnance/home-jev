{
  "name": "Wall button",
  "description": "The button toggles a room's lights, and lights it turned on survive the motion timeout.",
  "start": { "time": "20:00" },
  "steps": [
    {
      "event": { "type": "button", "room": "living" },
      "expect": { "living.ceiling": "standard", "living.blinds": "closed", "kitchen.can": "off" }
    },
    { "wait": 1, "event": { "type": "motion", "room": "living" }, "expect": { "living.ceiling": "standard" } },
    { "wait": 10, "expect": { "living.ceiling": "standard" } },
    {
      "event": { "type": "button", "room": "living" },
      "expect": { "living.ceiling": "off", "living.lamp": "off" }
    }
  ]
}
