{
  "name": "Motion while asleep",
  "description": "A late-night trip to the kitchen gets soft indirect light only, then it turns itself off.",
  "start": { "time": "02:15", "asleep": true },
  "steps": [
    {
      "event": { "type": "motion", "room": "entry" },
      "expect": { "entry.baseboard": "soft", "entry.ceiling": "off" }
    },
    {
      "wait": 1,
      "event": { "type": "motion", "room": "kitchen" },
      "expect": {
        "kitchen.undercounter": "soft",
        "kitchen.can": "off",
        "kitchen.pendant": "off",
        "kitchen.blinds": "closed",
        "bedroom.ceiling": "off"
      }
    },
    { "wait": 4, "expect": { "entry.baseboard": "off", "kitchen.undercounter": "soft" } },
    { "wait": 1, "expect": { "kitchen.undercounter": "off" } }
  ]
}
